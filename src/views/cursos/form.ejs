<%- include("../partials/header") %>
<h2><%= curso ? "Editar curso" : "Nuevo curso" %></h2>
<form method="post" action="<%= curso ? '/cursos/' + curso._id : '/cursos' %>" class="card p-4 shadow-sm">
  <label>Nombre</label><input class="form-control mb-3" name="nombre" required value="<%= curso?.nombre || '' %>">
  <label>Descripción</label><textarea class="form-control mb-3" name="descripcion" required><%= curso?.descripcion || '' %></textarea>
  <div class="row">
    <div class="col-md-4"><label>Nivel</label><select class="form-select mb-3" name="nivel"><% ["Principiante","Intermedio","Avanzado"].forEach(x=>{ %><option <%= curso?.nivel===x?"selected":"" %>><%=x%></option><% }) %></select></div>
    <div class="col-md-4"><label>Modalidad</label><select class="form-select mb-3" name="modalidad"><option>Presencial</option><option>Virtual</option></select></div>
    <div class="col-md-4"><label>Precio</label><input class="form-control mb-3" type="number" step="0.01" min="0" name="precio" required value="<%= curso?.precio || '' %>"></div>
  </div>
  <label>Capacidad</label><input class="form-control mb-3" type="number" min="1" name="capacidad" required value="<%= curso?.capacidad || '' %>">
  <button class="btn btn-dark">Guardar</button>
  <a class="btn btn-secondary" href="/cursos">Cancelar</a>
</form>
<%- include("../partials/footer") %>
