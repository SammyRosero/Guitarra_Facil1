<%- include("../partials/header") %>
<div class="row justify-content-center">
  <div class="col-md-5">
    <div class="card shadow-sm">
      <div class="card-body p-4">
        <h2 class="text-center">🎸 Guitarra Fácil</h2>
        <p class="text-center text-muted">Iniciar sesión</p>
        <% if (error) { %><div class="alert alert-danger"><%= error %></div><% } %>
        <form method="post" action="/login">
          <label class="form-label">Correo</label>
          <input class="form-control mb-3" type="email" name="correo" required>
          <label class="form-label">Contraseña</label>
          <input class="form-control mb-3" type="password" name="password" required>
          <button class="btn btn-dark w-100">Ingresar</button>
        </form>
        <a class="btn btn-link w-100 mt-2" href="/registro">Crear cuenta de estudiante</a>
      </div>
    </div>
  </div>
</div>
<%- include("../partials/footer") %>
