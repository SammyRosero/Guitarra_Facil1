<%- include("../partials/header") %>
<div class="row justify-content-center">
  <div class="col-md-6">
    <div class="card shadow-sm">
      <div class="card-body p-4">
        <h3>Registro de estudiante</h3>
        <% if (error) { %><div class="alert alert-danger"><%= error %></div><% } %>
        <form method="post" action="/registro">
          <div class="row">
            <div class="col-md-6 mb-3"><label>Nombre</label><input class="form-control" name="nombre" required></div>
            <div class="col-md-6 mb-3"><label>Apellido</label><input class="form-control" name="apellido" required></div>
          </div>
          <label>Correo</label><input class="form-control mb-3" type="email" name="correo" required>
          <label>Contraseña</label><input class="form-control mb-3" type="password" name="password" minlength="6" required>
          <button class="btn btn-dark">Registrarme</button>
          <a class="btn btn-secondary" href="/login">Volver</a>
        </form>
      </div>
    </div>
  </div>
</div>
<%- include("../partials/footer") %>
