<%- include("../partials/header") %>
<div class="d-flex justify-content-between mb-3"><h2>Matrículas</h2><a class="btn btn-dark" href="/matriculas/nueva">+ Nueva matrícula</a></div>
<table class="table table-bordered"><thead><tr><th>Estudiante</th><th>Curso</th><th>Fecha</th><th>Estado</th><th>Acción</th></tr></thead><tbody>
<% matriculas.forEach(m=>{ %><tr><td><%=m.estudiante.usuario.nombre%> <%=m.estudiante.usuario.apellido%></td><td><%=m.curso.nombre%></td><td><%=m.fechaMatricula.toLocaleDateString()%></td><td><%=m.estado%></td><td><%if(m.estado==="Activa"){%><form method="post" action="/matriculas/<%=m._id%>/cancelar"><button class="btn btn-sm btn-outline-danger">Cancelar</button></form><%}%></td></tr><% }) %>
</tbody></table>
<%- include("../partials/footer") %>
