<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>Bienvenido a Guitarra Fácil 🎸</h1>
        <span class="badge bg-success fs-6">Versión 2.0 (Redesplegada)</span>
    </div>
    <p class="text-muted">Sistema de gestión de clases de guitarra actualizado con control dinámico.</p>
    
    <div class="row text-center">
        <div class="col-md-3">
            <div class="card p-3 shadow-sm">
                <h5>Cursos activos</h5>
                <h3><%= totalCursos %></h3>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card p-3 shadow-sm">
                <h5>Estudiantes</h5>
                <h3><%= totalEstudiantes %></h3>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card p-3 shadow-sm">
                <h5>Profesores</h5>
                <h3><%= totalProfesores %></h3>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card p-3 shadow-sm">
                <h5>Matrículas activas</h5>
                <h3><%= totalMatriculas %></h3>
            </div>
        </div>
    </div>
</div>