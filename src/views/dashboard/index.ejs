<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">

<!-- Barra de Navegación Principal -->
<nav class="navbar navbar-expand-lg navbar-dark bg-dark mb-4">
    <div class="container-fluid">
        <a class="navbar-brand" href="/dashboard">🎸 Guitarra Fácil</a>
        <div class="collapse navbar-collapse">
            <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                <li class="nav-item"><a class="nav-link" href="/cursos">Cursos</a></li>
                <li class="nav-item"><a class="nav-link" href="/estudiantes">Estudiantes</a></li>
                <li class="nav-item"><a class="nav-link" href="/profesores">Profesores</a></li>
                <li class="nav-item"><a class="nav-link" href="/matriculas">Matrículas</a></li>
                <li class="nav-item"><a class="nav-link" href="/clases">Clases</a></li>
                <li class="nav-item"><a class="nav-link" href="/asistencia">Asistencia</a></li>
                <li class="nav-item"><a class="nav-link" href="/progreso">Progreso</a></li>
            </ul>
            <a href="/auth/logout" class="btn btn-danger btn-sm">Salir</a>
        </div>
    </div>
</nav>

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1>Bienvenido a Guitarra Fácil 🎸</h1>
            <p class="text-muted mb-0">Sistema de gestión de clases de guitarra — Versión 2.0 (Redesplegada)</p>
        </div>
        <span class="badge bg-success p-2 fs-6">v2.0 Activa</span>
    </div>

    <div class="row text-center">
        <div class="col-md-3 mb-3">
            <div class="card p-3 shadow-sm border-0 bg-light">
                <h5 class="text-secondary">Cursos activos</h5>
                <h2 class="fw-bold text-primary"><%= totalCursos %></h2>
            </div>
        </div>
        <div class="col-md-3 mb-3">
            <div class="card p-3 shadow-sm border-0 bg-light">
                <h5 class="text-secondary">Estudiantes</h5>
                <h2 class="fw-bold text-success"><%= totalEstudiantes %></h2>
            </div>
        </div>
        <div class="col-md-3 mb-3">
            <div class="card p-3 shadow-sm border-0 bg-light">
                <h5 class="text-secondary">Profesores</h5>
                <h2 class="fw-bold text-warning"><%= totalProfesores %></h2>
            </div>
        </div>
        <div class="col-md-3 mb-3">
            <div class="card p-3 shadow-sm border-0 bg-light">
                <h5 class="text-secondary">Matrículas activas</h5>
                <h2 class="fw-bold text-info"><%= totalMatriculas %></h2>
            </div>
        </div>
    </div>
</div>
