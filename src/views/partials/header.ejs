<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Guitarra Fácil</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="/css/style.css" rel="stylesheet">
</head>
<body>
<nav class="navbar navbar-expand-lg navbar-dark bg-dark">
  <div class="container">
    <a class="navbar-brand fw-bold" href="/dashboard">🎸 Guitarra Fácil</a>
    <% if (usuario) { %>
    <div class="d-flex align-items-center gap-2">
      <a class="btn btn-sm btn-outline-light" href="/cursos">Cursos</a>
      <% if (usuario.rol === "administrador") { %>
        <a class="btn btn-sm btn-outline-light" href="/estudiantes">Estudiantes</a>
        <a class="btn btn-sm btn-outline-light" href="/profesores">Profesores</a>
        <a class="btn btn-sm btn-outline-light" href="/matriculas">Matrículas</a>
        <a class="btn btn-sm btn-outline-light" href="/clases">Clases</a>
      <% } %>
      <% if (usuario.rol !== "estudiante") { %>
        <a class="btn btn-sm btn-outline-light" href="/asistencia">Asistencia</a>
      <% } %>
      <a class="btn btn-sm btn-outline-light" href="/progreso">Progreso</a>
      <form method="post" action="/logout" class="d-inline">
        <button class="btn btn-sm btn-warning">Salir</button>
      </form>
    </div>
    <% } %>
  </div>
</nav>
<main class="container py-4">
