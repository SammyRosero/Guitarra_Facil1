<%- include("../partials/header") %>
<div class="d-flex justify-content-between mb-3"><h2>Estudiantes</h2><a class="btn btn-dark" href="/estudiantes/nuevo">+ Nuevo estudiante</a></div>
<table class="table table-bordered"><thead><tr><th>Nombre</th><th>Correo</th><th>Nivel</th><th>Teléfono</th><th>Estado</th></tr></thead><tbody>
<% estudiantes.forEach(e=>{ %><tr><td><%=e.usuario.nombre%> <%=e.usuario.apellido%></td><td><%=e.usuario.correo%></td><td><%=e.nivel%></td><td><%=e.telefono||"-"%></td><td><%=e.estado?"Activo":"Inactivo"%></td></tr><% }) %>
</tbody></table>
<%- include("../partials/footer") %>
